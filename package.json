{
  "name": "doubt-site",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for the Doubt Discord bot (doubtbot.eu)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "biome:ci": "biome ci .",
    "biome:fix": "biome check --write . && biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  }
}
